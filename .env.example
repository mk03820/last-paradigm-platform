# The Last Paradigm Platform - Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Vercel Postgres) - Required for Story 4.4
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth.js) - Required for Story 8.1
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend API Key for magic link emails
# Get from: https://resend.com/api-keys
AUTH_RESEND_KEY=

# Email sender address (must be verified domain in Resend)
EMAIL_FROM=The Last Paradigm <noreply@lastparadigm.com>
