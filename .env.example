# The Last Paradigm Platform - Environment Variables
# Copy this file to .env.local and fill in the values

# Database (Vercel Postgres) - Required for Story 4.4
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
# POSTGRES_USER=
# POSTGRES_HOST=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth.js) - Required for Story 8.1
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend API Key for magic link emails
# Get from: https://resend.com/api-keys
AUTH_RESEND_KEY=

# Email sender address (must be verified domain in Resend)
EMAIL_FROM=The Last Paradigm <noreply@lastparadigm.com>

# Stripe Payment Integration - Required for Story 17.2
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price ID for Playbook 2 ($2,500)
# Create product/price in Stripe Dashboard
STRIPE_PRICE_ID=price_...

# Stripe Webhook Secret for signature verification (Story 17.4)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Inngest Background Jobs (Story 15.10)
# For production: https://www.inngest.com/dashboard
# Local dev uses Inngest Dev Server (no keys needed)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
